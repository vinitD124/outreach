# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lead research: real clinics' names, phone numbers and email addresses.
# Nothing in the app reads from here, and anything pushed stays in git
# history even after the files are deleted. Keep a backup off-repo.
/doc/

# stale duplicate of public/micare, which is the copy the renderer reads
/micare/

# leftover from the About image swap
/public/img/bg-img-2-old.webp
