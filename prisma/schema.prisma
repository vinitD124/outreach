generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String   @id @default(cuid())
  slug            String   @unique
  clinicName      String
  doctorName      String
  phone           String
  whatsapp        String
  email           String
  address         String
  
  emailSent       Boolean  @default(false)
  emailSentAt     DateTime?
  demoVisited     Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
